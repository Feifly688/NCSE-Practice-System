# Docker 部署配置
# 复制此文件为 .env 并修改

# MySQL root 密码
MYSQL_ROOT_PASSWORD=

# JWT 密钥（必须修改！用 openssl rand -hex 32 生成）
# 要求至少 32 字符，不满足时后端会拒绝启动
# （弱密钥可被离线爆破，进而伪造任意用户甚至管理员的 token）
JWT_SECRET=请替换为随机强密钥

# AI API（可选，不填则 AI 生题与 AI 解析功能不可用）
# 变量名以代码为准：API_KEY / BASE_URL / MODEL
# 旧的 MIMO_API_KEY / MIMO_BASE_URL 已废弃，代码不识别
API_KEY=
BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL=glm-4-flash

# 跨域白名单：前后端不同域时必填，多个用英文逗号分隔
CORS_ORIGIN=

# Cookie 属性（httpOnly 会话）
# ★ 前后端不同域时必须设为 none，否则浏览器不会带上 Cookie，登录态失效 ★
#   同源部署保持 lax；跨站部署改 none（此时 Secure 自动开启，必须走 HTTPS）
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
