# 数据库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ncse
MYSQL_PASSWORD=你的数据库密码
MYSQL_DATABASE=ncse-practice-system

# 应用端口（PM2 部署建议只监听 127.0.0.1，由 Nginx / Cloudflare Tunnel 转发）
APP_PORT=4000

# 运行环境
NODE_ENV=production

# JWT 密钥（必须修改！用 openssl rand -hex 32 生成）
JWT_SECRET=请替换为随机强密钥

# 登录 token 有效期（jsonwebtoken 的时间格式，单位支持 s / m / h / d / w，如 7d / 12h / 30m）
# 长有效期：登录时勾选「记住我」；短有效期：未勾选（公共设备场景）
# 前端提示文案由 GET /api/auth/session-policy 动态下发，改这里前端文案自动同步
# 修改后需重启 pm2；已签发的 token 仍按签发时的有效期执行
JWT_EXPIRES_IN=7d
JWT_EXPIRES_SHORT=2h

# 跨域白名单：前端域名，多个用英文逗号分隔
# 前端与后端不同域时（如 Cloudflare Pages + 独立后端）必填，否则登录会被浏览器拦截
# 示例：CORS_ORIGIN=https://your-site.pages.dev,https://www.your-domain.com
CORS_ORIGIN=

# 前端静态目录：前端部署在 Cloudflare Pages 时无需配置，后端只提供 /api
# FRONTEND_DIST=/home/user/ncse/frontend/dist

# AI API（用于 AI 生题和 AI 解析，变量名以代码为准：API_KEY / BASE_URL / MODEL）
API_KEY=你的API密钥
BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL=glm-4-flash

# 初始管理员（seed_admin.js 使用；用户名或邮箱至少填写一个）
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_NICKNAME=管理员
# 必须设置为至少 12 位的随机强密码，不得使用公开默认值
ADMIN_PASSWORD=
