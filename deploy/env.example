# 数据库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ncse
MYSQL_PASSWORD=你的数据库密码
MYSQL_DATABASE=ncse-practice-system

# 应用端口（PM2 部署建议只监听 127.0.0.1，由 Nginx / Cloudflare Tunnel 转发）
APP_PORT=4000

# 运行环境
NODE_ENV=production

# JWT 密钥（必须修改！用 openssl rand -hex 32 生成）
JWT_SECRET=请替换为随机强密钥

# 登录 token 有效期（jsonwebtoken 的时间格式，单位支持 s / m / h / d / w，如 7d / 12h / 30m）
# 长有效期：登录时勾选「记住我」；短有效期：未勾选（公共设备场景）
# 前端提示文案由 GET /api/auth/session-policy 动态下发，改这里前端文案自动同步
# 修改后需重启 pm2；已签发的 token 仍按签发时的有效期执行
JWT_EXPIRES_IN=7d
JWT_EXPIRES_SHORT=2h
#
# 说明：「记住我」同时控制两件事，二者需一致才形成闭环——
#   1. 服务端 token 有效期（上面的变量）
#   2. 前端存储位置：勾选 → localStorage（持久）；未勾选 → sessionStorage（随浏览器关闭清除）
# 前端存储行为见 frontend/src/services/authStorage.js

# 跨域白名单：前端域名，多个用英文逗号分隔
# 前端与后端不同域时（如 Cloudflare Pages + 独立后端）必填，否则登录会被浏览器拦截
# 示例：CORS_ORIGIN=https://your-site.pages.dev,https://www.your-domain.com
CORS_ORIGIN=

# 前端静态目录：前端部署在 Cloudflare Pages 时无需配置，后端只提供 /api
# FRONTEND_DIST=/home/user/ncse/frontend/dist

# AI API（用于 AI 生题和 AI 解析，变量名以代码为准：API_KEY / BASE_URL / MODEL）
API_KEY=你的API密钥
BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL=glm-4-flash

# ── 多供应商路由（可选）────────────────────────────────────────────
# 配置了 AGNES_API_KEY 后，Agnes 会成为拆题主力，智谱作为兜底：
#   · agnes-3.0-flash  单次响应快（同一片段 15s vs 智谱 45-100s），且支持看图
#   · 免费额度对「瞬时并发」敏感，靠 AGNES_CONCURRENCY 闸门压制（默认 3）
#   · 429 会自动退避重试，重试用尽才切换到下一个供应商
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-3.0-flash
# 图像生成模型（/v1/images/generations）。注意它是「生成图片」不是「看图识别」，
# 视觉识别请用 AGNES_MODEL（agnes-3.0-flash 支持 image_url 输入）
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
# 两个供应商各自允许的同时在途请求数（闸门），以及它们的优先顺序
AGNES_CONCURRENCY=3
BIGMODEL_CONCURRENCY=2
AI_PROVIDER_ORDER=agnes,bigmodel
# 整卷拆题的总并发（建议取两个供应商闸门之和）
PARSE_CONCURRENCY=5

# 初始管理员（seed_admin.js 使用；用户名或邮箱至少填写一个）
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_NICKNAME=管理员
# 必须设置为至少 12 位的随机强密码，不得使用公开默认值
ADMIN_PASSWORD=
